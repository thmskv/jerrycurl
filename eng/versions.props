<Project>
    <PropertyGroup Label="NuGet Package IDs">
        <OraclePackageId>Oracle.ManagedDataAccess.Core</OraclePackageId>
        <SqlServerPackageId>Microsoft.Data.SqlClient</SqlServerPackageId>
        <MySqlPackageId>MySql.Data</MySqlPackageId>
        <PostgresPackageId>Npgsql</PostgresPackageId>
        <PgvectorPackageId>Pgvector</PgvectorPackageId>
        <SqlitePackageId>Microsoft.Data.Sqlite</SqlitePackageId>
    </PropertyGroup>

    <PropertyGroup Label="NuGet Package Versions">
        <OraclePackageVersion>23.26.400</OraclePackageVersion>
        <SqlServerPackageVersion>7.1.1</SqlServerPackageVersion>
        <MySqlPackageVersion>26.10.0</MySqlPackageVersion>
        <PostgresPackageVersion>10.0.3</PostgresPackageVersion>
        <PgvectorPackageVersion>0.3.2</PgvectorPackageVersion>
        <SqlitePackageVersion>10.0.14</SqlitePackageVersion>
        <EntityFrameworkCorePackageVersion>10.0.14</EntityFrameworkCorePackageVersion>
        <JsonNetPackageVersion>13.0.4</JsonNetPackageVersion>
        <CSharpPackageVersion>5.0.0</CSharpPackageVersion>
        <!-- Pinned above the vulnerable versions pulled transitively by SqlClient and Oracle (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
        <PkcsPackageVersion>10.0.14</PkcsPackageVersion>
    </PropertyGroup>

    <PropertyGroup Label="Build Tooling Versions">
        <NetAnalyzersPackageVersion>10.0.403</NetAnalyzersPackageVersion>
        <GitVersioningPackageVersion>3.10.94</GitVersioningPackageVersion>
    </PropertyGroup>

    <PropertyGroup Label="Target Versions">
        <OracleTargetVersion>$(OraclePackageVersion)</OracleTargetVersion>
        <SqlServerTargetVersion>$(SqlServerPackageVersion)</SqlServerTargetVersion>
        <MySqlTargetVersion>$(MySqlPackageVersion)</MySqlTargetVersion>
        <PostgresTargetVersion>$(PostgresPackageVersion)</PostgresTargetVersion>
        <PgvectorTargetVersion>$(PgvectorPackageVersion)</PgvectorTargetVersion>
        <SqliteTargetVersion>$(SqlitePackageVersion)</SqliteTargetVersion>
        <EntityFrameworkCoreTargetVersion>$(EntityFrameworkCorePackageVersion)</EntityFrameworkCoreTargetVersion>
        <JsonNetTargetVersion>$(JsonNetPackageVersion)</JsonNetTargetVersion>
        <CSharpTargetVersion>$(CSharpPackageVersion)</CSharpTargetVersion>
    </PropertyGroup>
</Project>
