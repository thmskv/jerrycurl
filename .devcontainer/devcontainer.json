{
  "name": "jerrycurl",
  "image": "mcr.microsoft.com/devcontainers/dotnet:11.0",
  "features": {
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/node:2": {}
  },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dotnet.defaultSolution": "jerrycurl.slnx"
      }
    }
  },
  "postCreateCommand": "dotnet restore jerrycurl.slnx",
  "remoteUser": "vscode"
}
