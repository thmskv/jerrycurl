<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<EnableDefaultJerryItems>true</EnableDefaultJerryItems>
		<DefaultItemExcludes>$(DefaultItemExcludes);**/*.cssql</DefaultItemExcludes>
		<AdditionalFileItemNames>$(AdditionalFileItemNames);JerryFile</AdditionalFileItemNames>
	</PropertyGroup>

	<ItemGroup>
		<!-- Default visibility of generated pages: internal (default) or public. Overridden by @visibility in _imports.cssql or the page. -->
		<CompilerVisibleProperty Include="JerrycurlPageVisibility" />
	</ItemGroup>

	<ItemGroup Condition=" '$(EnableDefaultJerryItems)' == 'true' ">
		<JerryFile Include="**/*.cssql" />
	</ItemGroup>
</Project>
